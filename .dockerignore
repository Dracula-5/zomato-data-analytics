# Whitelist the application and dbt inputs used to build a small synthetic read-only
# warehouse. Local data, artifacts, virtualenvs and secrets never enter the image.
*
!pyproject.toml
!uv.lock
!README.md
!src/
!src/**
!contracts/
!contracts/**
!dbt/
!dbt/**
dbt/**/.user.yml
dbt/**/target/
dbt/**/dbt_packages/
dbt/**/logs/
src/**/__pycache__/
src/**/*.py[cod]
