# Copy to `.env` and fill in. `.env` is gitignored: never commit real values.

# --- Paths -------------------------------------------------------------------------------
# Folder that holds the source CSVs (restaurant, food, menu, users, orders, order_items, reviews).
DATA_DIR=data
LAKE_DIR=lake
WAREHOUSE_DIR=warehouse
ARTIFACTS_DIR=artifacts

# --- Run mode ----------------------------------------------------------------------------
# duckdb = local, zero cost. snowflake = cloud (milestone M5).
TARGET=duckdb
# Deterministic sample by hash(user_id), in percent. 100 = full data.
SAMPLE_PCT=5

# --- PII --------------------------------------------------------------------------------
# Random string that keeps email hashes from being reversed. Required for Snowflake.
# python -c "import secrets; print(secrets.token_hex(32))"
PII_HASH_SALT=

# --- Neo4j (M7) -----------------------------------------------------------------------
# At least 8 characters. Read by docker/neo4j/docker-compose.yml and the loader.
NEO4J_PASSWORD=

# --- AWS (M5) ----------------------------------------------------------------------------
# Credentials go in ~/.aws/credentials via `aws configure --profile zomato`, not here.
# Use the same region as the Snowflake account.
AWS_REGION=ap-southeast-7
AWS_PROFILE=zomato
# Normally empty: the bucket name comes from the Terraform output.
S3_BUCKET=

# --- Snowflake (M5) ----------------------------------------------------------------------
# <locator>.<region>.aws, as in https://app.snowflake.com/<region>.aws/<locator>/
# No password: `make cloud-keys` creates a key pair outside the repo.
SNOWFLAKE_ACCOUNT=

# --- OpenAI (M8) -------------------------------------------------------------------------
OPENAI_API_KEY=
# replay answers from eval/replay/ and never reaches the API. live spends real money.
LLM_MODE=replay
LLM_BUDGET_USD=2
