# Copy to `.env` and fill in. `.env` is gitignored: never commit real values.

# --- Paths -------------------------------------------------------------------------------
# Folder that holds the source CSVs (restaurant, food, menu, users, orders, order_items, reviews).
DATA_DIR=data
LAKE_DIR=lake
WAREHOUSE_DIR=warehouse
ARTIFACTS_DIR=artifacts

# --- Run mode ----------------------------------------------------------------------------
# duckdb = local, zero cost. snowflake = cloud (milestone M5).
TARGET=duckdb
# Deterministic sample by hash(user_id), in percent. 100 = full data.
SAMPLE_PCT=5

# --- AWS (M5) ----------------------------------------------------------------------------
# Credentials go in ~/.aws/credentials via `aws configure`, not here.
S3_BUCKET=
AWS_REGION=ap-south-1

# --- OpenAI (M8) -------------------------------------------------------------------------
OPENAI_API_KEY=
