# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Data and run outputs: never committed (the dataset is private and large).
# Anchored with a leading "/" so they match only the top-level folders, not e.g.
# src/zap/warehouse/ (an unanchored "warehouse/" once hid that package from git).
/data/
/lake/
/warehouse/
/artifacts/
/.cache/
*.duckdb
*.duckdb.wal
*.parquet

# Secrets and credentials
.env
.env.*
!.env.example
*.pem
*.p8
*.key
keys/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
crash.log

# dbt
dbt/**/target/
dbt/**/dbt_packages/
dbt/**/logs/
.user.yml

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
