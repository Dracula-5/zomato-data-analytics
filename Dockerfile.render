FROM python:3.12-slim AS build

WORKDIR /app
COPY --from=ghcr.io/astral-sh/uv:0.9.25 /uv /uvx /bin/

COPY pyproject.toml uv.lock README.md ./
COPY src ./src
COPY contracts ./contracts
COPY dbt ./dbt

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PYTHONUTF8=1

RUN uv sync --frozen --no-dev --no-default-groups --group api --group dbt --group quality
RUN uv run zap fixtures --out /tmp/zap-fixture \
    && uv run zap local --source /tmp/zap-fixture --sample-pct 100 --dataset fixture

FROM python:3.12-slim AS runtime

WORKDIR /app
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH="/app/src" \
    WAREHOUSE_DIR="/app/warehouse" \
    ZAP_DATASET="fixture" \
    PYTHONUTF8=1

COPY --from=build /app/.venv ./.venv
COPY --from=build /app/src ./src
COPY --from=build /app/warehouse/fixture.duckdb ./warehouse/fixture.duckdb

EXPOSE 10000
CMD ["sh", "-c", "uvicorn zap.api:app --host 0.0.0.0 --port ${PORT:-10000}"]
