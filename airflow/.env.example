# Copy to airflow/.env (gitignored). Read by airflow/docker-compose.yml.

# Host folder holding the source CSVs; mounted read-only at /data in the containers.
DATA_HOST_DIR=C:/path/to/your/data

# Host port for the Airflow UI/API (localhost only). Change it if 8080 is taken.
AIRFLOW_HOST_PORT=8080

# Local-only secrets. Generate your own, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
PII_HASH_SALT=

# Only for zomato_daily_snowflake (`make airflow-up-snowflake`).
SNOWFLAKE_ACCOUNT=
# Host folders with ~/.aws (the `zomato` profile) and the key from `make cloud-keys`.
AWS_HOST_DIR=C:/Users/you/.aws
SNOWFLAKE_KEY_HOST_DIR=C:/Users/you/.snowflake

# Optional: Slack-style incoming webhook (https only) for failure and deadline alerts.
ALERT_WEBHOOK_URL=
